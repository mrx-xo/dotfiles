(ert-deftest crash-bundle-committed-capture-makes-bundle-restorable ()
  (crash-bundle-test--fixture
   (let* ((frame-only (crash-bundle-test--run runs init 123))
          (placed (crash-bundle-test--run runs init 124)))
     (crash-bundle-test--capture frame-only 123)
     (crash-bundle-test--capture placed 124 'placement)
     (mr-x/crash-bundle-process init "sandbox")
     (let* ((a (mr-x/crash-bundle-directory store (concat "bundle-" (file-name-nondirectory frame-only))))
            (b (mr-x/crash-bundle-directory store (concat "bundle-" (file-name-nondirectory placed))))
            (capture-a (plist-get (mr-x/crash-capture-current frame-only) :directory))
            (capture-b (plist-get (mr-x/crash-capture-current placed) :directory)))
       (should (equal (crash-bundle-test--digest (expand-file-name "session-state.el" capture-a))
                      (crash-bundle-test--digest (expand-file-name "session-state.el" a))))
       (should-not (file-exists-p (expand-file-name "yabai-state.json" a)))
       (should (eq 'pending-frames (plist-get (mr-x/crash-bundle-status a) :phase)))
       (should-not (plist-get (mr-x/crash-bundle-status a) :yabai-required))
       (should (= 2 (plist-get (mr-x/crash-bundle-status a) :requested-frame-count)))
       (should (equal (crash-bundle-test--digest (expand-file-name "yabai-state.json" capture-b))
                      (crash-bundle-test--digest (expand-file-name "yabai-state.json" b))))
       (should (plist-get (mr-x/crash-bundle-status b) :yabai-required))
       (should (equal (plist-get (mr-x/crash-capture--read (expand-file-name "manifest.el" b)) :capture-id)
                      (plist-get (mr-x/crash-capture-current placed) :capture-id)))))))

(ert-deftest crash-bundle-active-pointer-is-repaired-and-terminal-orphans-cleaned ()
  (crash-bundle-test--fixture
   (crash-bundle-test--run runs init 123 nil "TAG-A")
   (sleep-for 0.01)
   (crash-bundle-test--run runs init 124 nil "TAG-B")
   (let* ((ids (plist-get (mr-x/crash-bundle-process init "sandbox") :bundled))
          (newest (mr-x/crash-bundle-active store))
          (older (car (remove newest ids)))
          (bundles (expand-file-name "bundles" store)))
     (mr-x/crash-capture--write (expand-file-name "active.el" store)
                                '(:schema-version 1 :bundle-id "bundle-missing"))
     (should (equal newest (mr-x/crash-bundle-active store)))
     (delete-file (expand-file-name "active.el" store))
     (should (equal newest (mr-x/crash-bundle-active store)))
     ;; A bundle left terminal by an interrupted consume is finished at startup.
     (mr-x/crash-bundle-transition (mr-x/crash-bundle-directory store newest)
                                   'review-only 'discarded)
     (make-directory (expand-file-name ".bundle-abandoned" bundles))
     (mr-x/crash-bundle-process init "sandbox")
     (should-not (file-exists-p (mr-x/crash-bundle-directory store newest)))
     (should-not (file-exists-p (expand-file-name ".bundle-abandoned" bundles)))
     (should (equal older (mr-x/crash-bundle-active store))))))

(ert-deftest crash-bundle-consume-requires-complete-and-advances-pointer-before-delete ()
  (crash-bundle-test--fixture
   (let ((older (crash-bundle-test--run runs init 123 nil "TAG-A")))
     (sleep-for 0.01)
     (let ((newer (crash-bundle-test--run runs init 124 nil "TAG-B")))
       (crash-bundle-test--capture newer 124)
       (mr-x/crash-bundle-process init "sandbox")
       (let* ((new-id (concat "bundle-" (file-name-nondirectory newer)))
              (old-id (concat "bundle-" (file-name-nondirectory older)))
              (bundle (mr-x/crash-bundle-directory store new-id)))
         (should-error (mr-x/crash-bundle-consume store new-id))
         (should (file-directory-p bundle))
         (mr-x/crash-bundle-transition bundle 'pending-frames 'restoring-frames :attempt 1)
         (mr-x/crash-bundle-transition bundle 'restoring-frames 'pending-yabai
                                       :restored-frames '((:restore-key "frame-a" :window-id nil)
                                                          (:restore-key "frame-b" :window-id nil)))
         (mr-x/crash-bundle-transition bundle 'pending-yabai 'complete)
         (cl-letf (((symbol-function 'delete-directory)
                    (lambda (&rest _) (error "fixture delete failure"))))
           (should-error (mr-x/crash-bundle-consume store new-id))
           (should (equal old-id (mr-x/crash-bundle-active store)))
           (should (file-directory-p bundle)))
         (mr-x/crash-bundle-consume store new-id)
         (should-not (file-directory-p bundle))
         (should (equal old-id (mr-x/crash-bundle-active store))))))))

