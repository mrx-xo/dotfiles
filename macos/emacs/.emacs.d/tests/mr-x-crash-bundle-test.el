(ert-deftest crash-bundle-report-is-bounded-and-evidence-copied-whole ()
  (crash-bundle-test--fixture
   (let ((run (crash-bundle-test--run runs init 123)))
     (mr-x/crash-capture--write (expand-file-name "command-errors.log" run)
                                (concat (make-string (* 3 1024 1024) ?e) "\nTAIL-MARK\n") t)
     (let* ((id (car (plist-get (mr-x/crash-bundle-process init "sandbox") :bundled)))
            (bundle (mr-x/crash-bundle-directory store id)))
       (should (<= (file-attribute-size (file-attributes (expand-file-name "report.log" bundle)))
                   (* 2 1024 1024)))
       (should (string-match-p "TAIL-MARK" (mr-x/crash-capture--text (expand-file-name "report.log" bundle))))
       (should (equal (crash-bundle-test--digest (expand-file-name "command-errors.log" run))
                      (crash-bundle-test--digest (expand-file-name "command-errors.log" bundle))))))))

