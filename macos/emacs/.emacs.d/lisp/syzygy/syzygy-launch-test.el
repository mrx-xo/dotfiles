(ert-deftest syzygy-launch-warm-catalogue-never-invents-preset-options ()
  "A stale preset must not make a rejected model or permission look supported."
  (let ((mr-x/agent-shell-presets '((?f "Fable" "fable[1m]" "obsolete-mode")))
        (syzygy-launch--capabilities (make-hash-table :test #'equal)))
    (puthash "claude" '((models . [((id . "claude-fable-5-1"))])
                        (modes . [((id . "bypassPermissions"))]) (efforts . []))
             syzygy-launch--capabilities)
    (cl-letf (((symbol-function 'buffer-list) (lambda () nil))
              ((symbol-function 'syzygy-launch--configs)
               (lambda () '(("claude" . ((:identifier . claude-code)))))))
      (let* ((agents (syzygy-launch--catalog))
             (settings (syzygy-launch--normalize-settings
                        '((agent . "claude") (model . "fable[1m]")
                          (mode . "bypassPermissions")) agents)))
        (should (equal (alist-get 'model settings) "claude-fable-5-1"))
        ;; The existing phone UI validates stored drafts/pins by choice ID.
        (should (syzygy-launch--known (alist-get 'models (car agents)) "fable[1m]"))
        (should (syzygy-launch--validate settings agents))
        (setf (alist-get 'mode settings) "obsolete-mode")
        (should-error (syzygy-launch--validate settings agents))))))

