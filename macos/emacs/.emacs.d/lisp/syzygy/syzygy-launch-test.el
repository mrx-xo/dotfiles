(ert-deftest syzygy-launch-validation-rejects-incompatible-settings ()
  (should (fboundp 'syzygy-launch--validate))
  (let ((agents (list (syzygy-launch-test--agent))))
    (should (syzygy-launch--validate
             '((agent . "codex") (model . "astra") (mode . "agent") (effort . "high")) agents))
    (dolist (bad '(((agent . "arbitrary-function") (model . "sol") (mode . "agent"))
                   ((agent . "codex") (model . "sonnet") (mode . "agent"))
                   ((agent . "codex") (model . "sol") (mode . "bypassPermissions"))
                   ((agent . "codex") (model . "sol") (mode . "agent") (effort . "impossible"))))
      (should-error (syzygy-launch--validate bad agents)))))

(ert-deftest syzygy-launch-live-capabilities-include-models-beyond-presets ()
  (should (fboundp 'syzygy-launch--state-options))
  (let ((state '((:session . ((:id . "one"))))))
    (cl-letf (((symbol-function 'agent-shell--get-available-models)
               (lambda (_) '(((:model-id . "astra") (:name . "Astra") (:description . "Advertised")))) )
              ((symbol-function 'agent-shell--get-available-modes)
               (lambda (_) '(((:id . "agent") (:name . "Agent")))))
              ((symbol-function 'agent-shell--config-option-by-category)
               (lambda (_ category)
                 (when (equal category "thought_level")
                   '((:id . "reasoning_effort") (:options . (((:value . "high") (:name . "High")))))))))
      (let ((got (syzygy-launch--state-options state)))
        (should (equal (alist-get 'id (aref (alist-get 'models got) 0)) "astra"))
        (should (equal (alist-get 'id (aref (alist-get 'efforts got) 0)) "high"))))))

(ert-deftest syzygy-launch-invalid-request-never-starts-an-agent ()
  (should (fboundp 'syzygy-launch-json))
  (cl-letf (((symbol-function 'syzygy-launch--catalog)
             (lambda () (list (syzygy-launch-test--agent))))
            ((symbol-function 'agent-shell--start)
             (lambda (&rest _) (ert-fail "Invalid settings reached agent start"))))
    (let ((got (syzygy-launch-test--decode
                (syzygy-launch-json
                 (syzygy-bridge-encode-json
                  '((cwd . "/tmp") (settings . ((agent . "codex") (model . "unknown") (mode . "agent")))))))))
      (should (eq (alist-get 'ok got) :false))
      (should (string-match-p "model" (alist-get 'error got))))))

(ert-deftest syzygy-launch-effort-is-confirmed-before-prompt ()
  (should (fboundp 'syzygy-launch--configure))
  (with-temp-buffer
    (let ((state '((:session . ((:id . "ready"))) (:set-model . t) (:set-session-mode . t)))
          (effort "low") events)
      (cl-letf (((symbol-function 'agent-shell--state) (lambda () state))
                ((symbol-function 'agent-shell--current-model-id) (lambda (_) "sol"))
                ((symbol-function 'agent-shell--current-mode-id) (lambda (_) "agent"))
                ((symbol-function 'agent-shell--config-option-by-category)
                 (lambda (_ _) `((:id . "reasoning_effort") (:current-value . ,effort)
                                  (:options . (((:value . "high")))))))
                ((symbol-function 'agent-shell--set-session-config-option)
                 (lambda (&rest args)
                   (push 'effort events)
                   (setq effort (plist-get args :value))
                   (funcall (plist-get args :on-success))))
                ((symbol-function 'shell-maker-submit)
                 (lambda () (push (buffer-string) events))))
        (syzygy-launch--configure (current-buffer)
                                  '((model . "sol") (mode . "agent") (effort . "high"))
                                  "Do the work")
        (should (equal (nreverse events) '(effort "Do the work")))))))

