(ert-deftest syzygy-launch-legacy-rejection-retains-exact-created-buffer ()
  (with-temp-buffer
    (let ((buffer (current-buffer)))
      (cl-letf (((symbol-function 'mr-x/agent-shell-spawn-for-mobile)
                 (lambda (_cwd _name _task _preset _clone on-created)
                   (funcall on-created buffer)
                   (user-error "Model refused"))))
        (let ((reply (syzygy-launch-test--decode
                      (syzygy-launch-legacy-json
