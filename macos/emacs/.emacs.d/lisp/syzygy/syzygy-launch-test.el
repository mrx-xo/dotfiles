(ert-deftest syzygy-launch-setting-gets-budget-after-slow-startup ()
  "Startup must not consume the separate model-confirmation deadline."
  (with-temp-buffer
    (let ((clock 0) (syzygy-launch--timeout 2) callback sent (model "old"))
      (cl-letf (((symbol-function 'float-time) (lambda (&optional _) clock))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _)
                   (cl-incf clock)
                   (when (and callback (= clock 3))
                     (setq model "sol") (funcall callback))))
                ((symbol-function 'agent-shell--state)
                 (lambda () (when (>= clock 2) '((:session . ((:id . "ready")))
                                                (:set-model) (:set-session-mode)))))
                ((symbol-function 'agent-shell--current-model-id) (lambda (_) model))
                ((symbol-function 'agent-shell--current-mode-id) (lambda (_) "agent"))
                ((symbol-function 'agent-shell--config-option-set-model-id)
                 (lambda (&rest args) (setq callback (plist-get args :on-success))))
                ((symbol-function 'shell-maker-submit) (lambda () (setq sent (buffer-string)))))
        (syzygy-launch--configure (current-buffer) '((model . "sol") (mode . "agent")) "Work")
        (should (equal sent "Work"))
        (should (= clock 3))))))

(ert-deftest syzygy-launch-json-old-draft-confirms-canonical-model-and-keeps-recovery ()
  "The HTTP bridge must normalize before validation and retain partial failures."
  (dolist (reject '(nil t))
    (with-temp-buffer
      (let* ((buffer (current-buffer)) (model "opus") sent requested
             (state '((:session . ((:id . "ready"))) (:set-model) (:set-session-mode))))
        (cl-letf (((symbol-function 'syzygy-launch--catalog)
                   (lambda () '(((id . "claude") (name . "Claude")
                                 (models . [((id . "claude-fable-5-1"))])
                                 (modes . [((id . "bypassPermissions"))]) (efforts . [])))))
                  ((symbol-function 'syzygy-launch--configs)
                   (lambda () '(("claude" . ((:identifier . claude-code))))))
                  ((symbol-function 'agent-shell--start)
                   (lambda (&rest args)
                     (should-not (map-elt (plist-get args :config) :default-model-id))
                     (should-not (map-elt (plist-get args :config) :default-session-mode-id))
                     buffer))
                  ((symbol-function 'agent-shell--state) (lambda () state))
                  ((symbol-function 'agent-shell--get-available-models)
                   (lambda (_) '(((:model-id . "claude-fable-5-1")))))
                  ((symbol-function 'agent-shell--current-model-id) (lambda (_) model))
                  ((symbol-function 'agent-shell--current-mode-id) (lambda (_) "bypassPermissions"))
                  ((symbol-function 'agent-shell--config-option-set-model-id)
                   (lambda (&rest args)
                     (setq requested (plist-get args :model-id))
                     (if reject
                         (funcall (plist-get args :on-failure) '((message . "Rejected")) nil)
                       (setq model requested) (funcall (plist-get args :on-success)))))
                  ((symbol-function 'mr-x/agent-label-sync) #'ignore)
                  ((symbol-function 'shell-maker-submit) (lambda () (setq sent (buffer-string)))))
          (let ((reply (syzygy-launch-test--decode
                        (syzygy-launch-json
                         (syzygy-bridge-encode-json
                          `((cwd . ,temporary-file-directory) (task . "First prompt")
                            (settings . ((agent . "claude") (model . "fable[1m]")
                                         (mode . "bypassPermissions")))))))))
            (should (equal requested "claude-fable-5-1"))
            (should (equal (alist-get 'bufferName reply) (buffer-name buffer)))
            (if reject
                (progn (should (eq (alist-get 'ok reply) :false))
                       (should (string-match-p "Rejected" (alist-get 'error reply)))
                       (should-not sent))
              (should (eq (alist-get 'ok reply) t))
              (should (equal sent "First prompt")))))))))

(ert-deftest syzygy-launch-claude-added-context-suffix-is-not-a-failed-launch ()
  "The SDK can publish its 1M spelling only after a successful model switch."
  (with-temp-buffer
    (let ((model "opus") sent
          (state '((:session . ((:id . "ready"))) (:set-model) (:set-session-mode))))
      (cl-letf (((symbol-function 'agent-shell--state) (lambda () state))
                ((symbol-function 'agent-shell--get-available-models)
                 (lambda (_) `(((:model-id . ,(if (equal model "opus")
                                                 "claude-fable-5-1" model))))))
                ((symbol-function 'agent-shell--current-model-id) (lambda (_) model))
                ((symbol-function 'agent-shell--current-mode-id) (lambda (_) "bypassPermissions"))
                ((symbol-function 'agent-shell--config-option-set-model-id)
                 (lambda (&rest args)
                   (should (equal (plist-get args :model-id) "claude-fable-5-1"))
                   (setq model "claude-fable-5-1[1m]")
                   (funcall (plist-get args :on-success))))
                ((symbol-function 'shell-maker-submit) (lambda () (setq sent (buffer-string)))))
        (syzygy-launch--configure (current-buffer)
                                 '((agent . "claude") (model . "claude-fable-5-1")
                                   (mode . "bypassPermissions")) "Work")
        (should (equal sent "Work"))))))

(ert-deftest syzygy-launch-model-comparison-never-substitutes-or-downgrades ()
  (dolist (case '(("claude" "claude-fable-5-1" "claude-fable-5-1[1m]" t)
                  ("claude" "claude-fable-5-1" "claude-fable-5-1-1m" t)
