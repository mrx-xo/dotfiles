(ert-deftest syzygy-launch-old-claude-drafts-use-advertised-model-ids ()
  "Old phone drafts must launch the intended model, not fail literal equality."
  (dolist (case '(("fable[1m]" "claude-fable-5-1")
                  ("opus[1m]" "opus")))
    (with-temp-buffer
      (let ((sent nil))
        (cl-letf (((symbol-function 'agent-shell--state)
                   (lambda () '((:session . ((:id . "ready")))
                                (:set-model . t) (:set-session-mode . t))))
                  ((symbol-function 'agent-shell--get-available-models)
                   (lambda (_) '(((:model-id . "claude-fable-5-1"))
                                 ((:model-id . "opus")))))
                  ((symbol-function 'agent-shell--current-model-id) (lambda (_) (cadr case)))
                  ((symbol-function 'agent-shell--current-mode-id) (lambda (_) "bypassPermissions"))
                  ((symbol-function 'shell-maker-submit) (lambda () (setq sent (buffer-string)))))
          (syzygy-launch--configure (current-buffer)
                                   `((agent . "claude") (model . ,(car case))
                                     (mode . "bypassPermissions")) "First prompt")
          (should (equal sent "First prompt")))))))

(ert-deftest syzygy-launch-model-resolution-is-agent-scoped-and-preserves-context ()
  (dolist (case '(("claude" "fable[1m]" ("claude-fable-5-1") "claude-fable-5-1")
                  ("claude" "fable[1m]" ("claude-fable-5-1" "claude-fable-5-1[1m]") "claude-fable-5-1[1m]")
                  ("claude" "opus[1m]" ("opus" "opus[1m]") "opus[1m]")
                  ("claude" "claude-fable-5" ("claude-fable-5-1") "claude-fable-5")
                  ("codex" "fable[1m]" ("claude-fable-5-1") "fable[1m]")
                  ("deepseek" "default" ("default") "default")
                  ("opencode" "openai/gpt-6-luna" ("openai/gpt-6-luna") "openai/gpt-6-luna")))
    (should (equal (syzygy-launch--resolve-model
                    (nth 0 case) (nth 1 case)
                    (mapcar (lambda (id) `((id . ,id))) (nth 2 case)))
                   (nth 3 case)))))

(ert-deftest syzygy-launch-applies-settings-before-first-prompt ()
  "A new session starts without defaults; each requested setting must settle."
  (with-temp-buffer
    (let ((model "opus") (mode "default") events
          (state '((:session . ((:id . "ready"))) (:set-model) (:set-session-mode))))
      (cl-letf (((symbol-function 'agent-shell--state) (lambda () state))
                ((symbol-function 'agent-shell--get-available-models)
                 (lambda (_) '(((:model-id . "opus")) ((:model-id . "claude-fable-5-1")))))
                ((symbol-function 'agent-shell--current-model-id) (lambda (_) model))
                ((symbol-function 'agent-shell--current-mode-id) (lambda (_) mode))
                ((symbol-function 'agent-shell--config-option-set-model-id)
                 (lambda (&rest args)
                   (setq model (plist-get args :model-id))
                   (push model events) (funcall (plist-get args :on-success))))
                ((symbol-function 'agent-shell--config-option-set-mode-id)
                 (lambda (&rest args)
                   (setq mode (plist-get args :mode-id))
                   (push mode events) (funcall (plist-get args :on-success))))
                ((symbol-function 'shell-maker-submit) (lambda () (push (buffer-string) events))))
        (syzygy-launch--configure (current-buffer)
                                 '((agent . "claude") (model . "claude-fable-5-1")
                                   (mode . "bypassPermissions")) "First prompt")
        (should (equal (nreverse events)
                       '("claude-fable-5-1" "bypassPermissions" "First prompt")))))))

(ert-deftest syzygy-launch-rejected-model-reports-cause-without-prompt ()
  (with-temp-buffer
    (let ((syzygy-launch--timeout 0))
      (cl-letf (((symbol-function 'agent-shell--state)
                 (lambda () '((:session . ((:id . "ready")))
                              (:set-model . t) (:set-session-mode . t))))
                ((symbol-function 'agent-shell--current-model-id) (lambda (_) "opus"))
                ((symbol-function 'agent-shell--current-mode-id) (lambda (_) "bypassPermissions"))
                ((symbol-function 'agent-shell--config-option-set-model-id)
                 (lambda (&rest args)
                   (funcall (plist-get args :on-failure)
                            '((code . -32603) (message . "Internal error")
                              (data . "Model unavailable for this account")) nil)))
                ((symbol-function 'shell-maker-submit) (lambda () (ert-fail "Sent after rejection"))))
        (let ((err (should-error
                    (syzygy-launch--configure (current-buffer)
                                             '((model . "claude-fable-5-1")
                                               (mode . "bypassPermissions")) "First prompt"))))
          (should (string-match-p "Model unavailable for this account" (error-message-string err)))
          (should (string-empty-p (buffer-string))))))))

