# -*- mode: sh -*-

# Test binding - press cmd+x to verify skhd is working
# cmd - x : osascript -e 'display notification "skhd test successful"'

# Emacs
cmd + shift - e : /opt/homebrew/opt/emacs-plus@30/bin/emacsclient -c -n -a ""
cmd - e : ~/.dotfiles/macos/scripts/emacs-cycle.sh

# hotdox ✦ Hyper one-taps (the old chords stay bound below — the board's
# daily-driver keys still send them as real keycodes)
hyper - e : ~/.dotfiles/macos/scripts/emacs-cycle.sh
hyper - a : ~/.dotfiles/macos/scripts/org-agenda-frame.sh
hyper - space : ~/.dotfiles/macos/scripts/scratchpad-emacs.sh scratch
# hyper - g : magit — pending a focus-emacs-then-magit helper script

cmd + shift - a : ~/.dotfiles/macos/scripts/org-agenda-frame.sh
cmd + shift - r : ~/.dotfiles/macos/scripts/emacs-restart.sh
cmd + shift + alt - r : ~/.dotfiles/macos/scripts/emacs-restart-restore.sh
cmd + shift - s : ~/.dotfiles/macos/scripts/emacs-sandbox.sh --show
cmd + shift + ctrl - s : ~/.dotfiles/macos/scripts/emacs-sandbox.sh --test --show
# Deliberately visit agent windows; press again to return to the saved window.
# Meh (ctrl+alt+shift) since 2026-10-22: Hyper+B belongs to the Iris Emacs layer (buffers).
meh - b : ~/.dotfiles/macos/scripts/agent-workspace
cmd + shift - b : ~/.dotfiles/macos/scripts/boox-mirror.sh
cmd + shift - v : emacsclient --eval "(with-current-buffer (or (car (agent-shell-buffers)) (current-buffer)) (agent-shell-yank-dwim))"

# Native yabai scratchpad bindings
cmd + shift - space : ~/.dotfiles/macos/scripts/scratchpad-emacs.sh scratch
cmd + shift - o : ~/.dotfiles/macos/scripts/scratchpad-emacs.sh scratch-org

# Additional scratchpad toggles
# "pageup" : open -a "Messages"
# "pagedown" : open -a "Discord"

cmd + shift - tab : yabai -m window --focus recent

# hotdox ✦ Hyper (⌘⌃⌥⇧) / ◆ Meh (⌃⌥⇧) thumb keys — migrated 2026-07-28.
# alt-hjkl (and alt-1..4, alt-t/f) are freed: Meta works in Emacs again.
hyper - h : yabai -m window --focus west
hyper - j : yabai -m window --focus south
hyper - k : yabai -m window --focus north
hyper - l : yabai -m window --focus east

meh - h : yabai -m window --warp west
meh - j : yabai -m window --warp south
meh - k : yabai -m window --warp north
meh - l : yabai -m window --warp east

ctrl + alt - left : yabai -m window --resize left:-20:0
ctrl + alt - right : yabai -m window --resize right:20:0
ctrl + alt - up    : yabai -m window --resize top:0:-20
ctrl + alt - down  : yabai -m window --resize bottom:0:20

cmd - 1 : yabai -m space --focus 1

hyper - t : yabai -m window --toggle float

hyper - f : yabai -m window --toggle zoom-fullscreen

# Move the summoned keymap overlay, otherwise the focused window; follow it.
# Numbers are yabai's current display indices (they can change on disconnect).

# Laptop display
hyper - 1 : ~/.dotfiles/macos/scripts/keymap-display.sh 1

# Vertical Monitor
hyper - 2 : ~/.dotfiles/macos/scripts/keymap-display.sh 2

# Main Left Monitor
hyper - 3 : ~/.dotfiles/macos/scripts/keymap-display.sh 3

# Main Right Monitor
hyper - 4 : ~/.dotfiles/macos/scripts/keymap-display.sh 4

# iPad (Sidecar)
hyper - 5 : ~/.dotfiles/macos/scripts/keymap-display.sh 5

# Focus only - no window movement
meh - 1 : yabai -m display --focus 1
meh - 2 : yabai -m display --focus 2
meh - 3 : yabai -m display --focus 3
meh - 4 : yabai -m display --focus 4
meh - 5 : yabai -m display --focus 5

# Tab nav lives in firmware since keymap v3 (2026-07-29): Nav layer Tab◀/Tab▶
# send real ⌘⌥←/→ — the old ✦,/✦. Hammerspoon binds are retired.

# Monitor input switching (DDC "KVM") — see docs/monitor-setup.org
ctrl + alt - g : ~/.dotfiles/macos/scripts/monitor-mode.sh nemesis
ctrl + alt - m : ~/.dotfiles/macos/scripts/monitor-mode.sh pollux
ctrl + alt - w : ~/.dotfiles/macos/scripts/monitor-mode.sh pollux work
ctrl + alt - 0 : ~/.dotfiles/macos/scripts/monitor-mode.sh reset
ctrl + alt - r : ~/.dotfiles/macos/scripts/vengeance-wake.sh nemesis pollux
# per-display toggles POLLUX <-> NEMESIS (3/4 match yabai display indices)
ctrl + alt - 3 : ~/.dotfiles/macos/scripts/monitor-mode.sh toggle romulus
ctrl + alt - 4 : ~/.dotfiles/macos/scripts/monitor-mode.sh toggle remus
# KOMAX (Keychron K0 Max), screen then machine. M1-M3 arm a screen, M4/M5
# and the knob press fire at a machine; nothing armed = both Dells (work: nothing).
# Spec: docs/active/specs/2026-10-21-komax-desk-grammar-design.md; rig notes
# "Monitor Mode". macOS ignores F20+ from hardware keyboards; F18 stays free
# (kanata's dummy key on NEMESIS). NEMESIS fires route through vengeance-wake,
# which skips the wake when only NYX is armed.
f13 : ~/.dotfiles/macos/scripts/monitor-mode.sh arm romulus
f14 : ~/.dotfiles/macos/scripts/monitor-mode.sh arm remus
f15 : ~/.dotfiles/macos/scripts/monitor-mode.sh arm nyx
f16 : ~/.dotfiles/macos/scripts/monitor-mode.sh fire pollux
f17 : ~/.dotfiles/macos/scripts/vengeance-wake.sh fire nemesis
f19 : ~/.dotfiles/macos/scripts/monitor-mode.sh fire work

alt + shift - b : yabai -m space --balance
alt + shift - r : yabai --restart-service
alt + shift - s : sketchybar --reload
cmd + shift + alt - s : brew services restart sketchybar

ctrl - space : ~/.dotfiles/macos/yabai/scripts/toggle_layout.sh

# Send focused window to a new space and follow it
cmd + ctrl - 0x18 : yabai -m space --create && \
                    index="$(yabai -m query --spaces --display | jq 'map(select(."is-native-fullscreen" == false))[-1].index')" && \
                    yabai -m window --space "${index}" && \
                    yabai -m space --focus "${index}"
