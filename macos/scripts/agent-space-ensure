#!/bin/bash
# agent-space-ensure — make sure the yabai space labelled "agent" exists and the
# agent-window rules point at it. Idempotent and cheap; called from yabairc at
# start, from display_added/display_removed/space_destroyed signals (macOS
# destroys the space when the display it lived on goes away, which also
# invalidates rules that were resolved against it), and by agent-open /
# sandbox-view right before they open a window.
set -eu
JQ=$(command -v jq || echo /opt/homebrew/bin/jq)
if ! yabai -m query --spaces | "$JQ" -e 'map(select(.label == "agent")) | length > 0' >/dev/null; then
  yabai -m space --create last && yabai -m space last --label agent
fi
for r in agent-browser agent-screenshare; do yabai -m rule --remove "$r" >/dev/null 2>&1 || true; done
# Browser ownership comes from its process/profile, not the app name.
yabai -m rule --remove agent-sandbox >/dev/null 2>&1 || true
yabai -m rule --add label="agent-sandbox" app="^Emacs$" title="^SANDBOX" space=agent manage=off mouse_follows_focus=off
yabai -m rule --add label="agent-screenshare" app="^Screen Sharing$" space=agent mouse_follows_focus=off
yabai -m rule --apply agent-screenshare >/dev/null 2>&1
HERE="$(dirname "$(readlink -f "$0")")"
yabai -m signal --remove agent-browser-window_created >/dev/null 2>&1 || true
yabai -m signal --add label=agent-browser-window_created event=window_created app="^Brave Browser$" \
  action="python3 \"$HERE/agent-workspace.py\" route \"\$YABAI_WINDOW_ID\""
# Screen Sharing reuses and retitles its connection window, so the rule misses it
# at creation time; re-apply on create and on title change.
for ev in window_created window_title_changed; do
  yabai -m signal --remove "agent-screenshare-$ev" >/dev/null 2>&1 || true
  yabai -m signal --add label="agent-screenshare-$ev" event="$ev" app="^Screen Sharing$" \
    action="yabai -m rule --apply agent-screenshare"
done
