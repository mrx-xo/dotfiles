#!/bin/bash
# secret — print one secret to stdout. macOS Keychain first, Vaultwarden (rbw) fallback.
#   secret <name>           print it. Only ever use inside a redirect or $(...), never bare.
#   secret --cache <name>   copy <name> from the vault into Keychain so it works while rbw is locked
#   secret --set <name>     store a value read from stdin: `pbpaste | secret --set <name>`
#                           (never `security add-generic-password -w` at the prompt: it truncates at 128)
#   secret --list           item names in both stores (no values)
set -euo pipefail
cmd=${1:-}; name=${2:-$cmd}
case "$cmd" in
  --list)
    security dump-keychain 2>/dev/null | grep -oE '"svce"<blob>="[^"]+"' | sed 's/.*="//;s/"$//' | sort -u
    rbw unlocked >/dev/null 2>&1 && rbw list ;;
  --cache)
    rbw unlocked >/dev/null 2>&1 || rbw unlock
    printf 'add-generic-password -a "%s" -s "%s" -U -w "%s"\n' "$USER" "$name" "$(rbw get "$name")" | security -i >/dev/null
    echo "cached $name in Keychain" >&2 ;;
  --set)
    [ -n "$name" ] && [ "$name" != "--set" ] || { echo "secret --set <name>: missing name" >&2; exit 2; }
    [ -t 0 ] && { echo "secret --set reads the value from stdin, e.g. pbpaste | secret --set $name" >&2; exit 2; }
    value=$(cat; printf x); value=${value%x}; value=${value%$'\n'}; value=${value%$'\r'}
    [ -n "$value" ] || { echo "secret --set $name: empty value, nothing stored" >&2; exit 2; }
    printf 'add-generic-password -a "%s" -s "%s" -U -w "%s"\n' "$USER" "$name" "$value" | security -i >/dev/null
    stored=$(security find-generic-password -s "$name" -w)
    [ "$stored" = "$value" ] || { echo "secret --set $name: readback mismatch" >&2; exit 1; }
    shape=plain; case "$value" in eyJ*.*.*) shape=JWT ;; esac
    echo "stored $name: ${#value} chars, $shape" >&2 ;;
  -*|"") sed -n '2,7p' "$0" >&2; exit 2 ;;
  *)
    security find-generic-password -s "$name" -w 2>/dev/null && exit 0
    rbw unlocked >/dev/null 2>&1 || rbw unlock
    rbw get "$name" ;;
esac
