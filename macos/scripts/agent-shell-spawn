#!/bin/bash
# agent-shell-spawn NAME CWD [TASK] [PRESET]
#
# Bridge for acp-mobile's /api/spawn (see handleSpawn in main.go): asks
# the Emacs daemon to open a new agent-shell convo in CWD, pane-labeled
# NAME, optionally submitting TASK as the first prompt once the session
# handshake completes.  PRESET is a single char key into the rig's
# mr-x/agent-shell-presets (model + permission mode).  Lives on the
# daemon's PATH via ~/.local/bin (extraPath in ~/.acp-mobile/config.json).
set -euo pipefail

name="${1-}"
cwd="${2:?usage: agent-shell-spawn NAME CWD [TASK] [PRESET]}"
task="${3:-}"
preset="${4:-}"

esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

out=$(emacsclient --eval \
  "(mr-x/agent-shell-spawn-for-mobile \"$(esc "$cwd")\" \"$(esc "$name")\" \"$(esc "$task")\" \"$(esc "$preset")\")")

case "$out" in
  nil) echo "spawn failed: daemon returned nil" >&2; exit 1 ;;
  *error*) echo "spawn failed: $out" >&2; exit 1 ;;
esac
echo "$out"
