#!/usr/bin/env python3
"""lightsctl — headless control engine for the VENGEANCE lights.

The single seam between UIs and the machine: every front-end (gum, Textual,
whatever comes next) calls these subcommands and parses the JSON/ANSI they
print. No UI ever touches SSH or the control files directly — swap skins
freely as long as they speak this contract.

  lightsctl status [--json]        current effect, preset, countdown, colors
  lightsctl list [--json]          available effects and presets
  lightsctl set-effect NAME        pin one effect
  lightsctl fan NAME COLOR         override one fan/group (see: lightsctl fan)
  lightsctl set-preset NAME        rotation drawing from a preset's pool
  lightsctl rotation on|off        resume rotation / pin whatever's showing
  lightsctl reset                  wipe the slate: rotation, everything preset,
                                   full brightness, no force, no fan overrides
  lightsctl restart-engine         unstick a wedged engine: kill + relaunch the
                                   ICUELights task on the box
  lightsctl deploy                 ship committed lights code: push to origin,
                                   pull on the box, restart the engine
  lightsctl push                   dev loop: scp the WORKING TREE's
                                   shared/lights/*.py to the box + restart —
                                   uncommitted code on real LEDs in seconds
  lightsctl random                 roll a fresh parametric look (the 🎲)
  lightsctl brightness 0.0-1.0     scale overall brightness
  lightsctl preview NAME [--secs S] animate an effect's colors locally

Talks to the box named by $LIGHTS_HOST (default: vengeance, an ssh alias).
Control lives in ~/icue-scheduler/{control,status}.json on that box.
"""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "shared" / "lights"))
import effects  # noqa: E402
import rig  # noqa: E402
from schedule import next_boundary  # noqa: E402

HOST = os.environ.get("LIGHTS_HOST", "vengeance")
MAC = os.environ.get("LIGHTS_MAC", "34:5A:60:C0:95:87")  # VENGEANCE Realtek NIC
CONTROL = "icue-scheduler/control.json"   # home-relative on the box
STATUS = "icue-scheduler/status.json"
_SOCK = f"/tmp/lightsctl-{HOST}.sock"
_SSH = ["ssh", "-o", "ControlMaster=auto", "-o", f"ControlPath={_SOCK}",
        "-o", "ControlPersist=120", "-o", "ConnectTimeout=6",
        "-o", "BatchMode=yes", HOST]


def _run(cmd, data=None):
    return subprocess.run(_SSH + [cmd], input=data, capture_output=True,
                          text=True)


def read_remote(path):
    r = _run(f"cat {path} 2>/dev/null")
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {}


def write_control(control):
    _run(f"cat > {CONTROL}", data=json.dumps(control))


def current_control():
    c = read_remote(CONTROL)
    if not c:
        c = {"mode": "rotation", "preset": "rotation", "brightness": 1.0}
    c.setdefault("brightness", 1.0)
    return c


STALE_SECS = 10  # healthy engine rewrites status.json every ~1s


def read_status():
    """status.json plus its age in seconds — judged entirely by the box's own
    clock (date vs mtime), so Mac/box clock skew can't fake a wedge.
    Returns (status_dict, age): (None, None) unreachable, ({}, None) reachable
    but no status file, (st, None) file present but stat failed."""
    r = _run(f"cat {STATUS} 2>/dev/null; echo; date +%s; "
             f"stat -c %Y {STATUS} 2>/dev/null; true")
    if r.returncode != 0:
        return None, None
    st, nums = {}, []
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith("{"):
            try:
                st = json.loads(line)
            except ValueError:
                pass
        elif line.isdigit():
            nums.append(int(line))
    age = nums[0] - nums[1] if len(nums) == 2 else None
    return st, age


def engine_wedged(st, age):
    """True when the box answers but the engine isn't painting: status.json
    missing entirely, or older than the engine's ~1s heartbeat allows."""
    if st is None:  # unreachable — that's an off box, not a wedged engine
        return False
    return age is None or age > STALE_SECS


def wedge_banner(age):
    ago = "missing" if age is None else f"{age}s stale"
    return (f"⚠ engine wedged — status.json {ago}, control.json is being "
            "ignored\n  fix: lightsctl restart-engine")


# --- power / reachability ------------------------------------------------
def is_reachable():
    """True if VENGEANCE answers SSH (i.e. awake). ~4s to fail when off."""
    r = subprocess.run(["ssh", "-o", "ConnectTimeout=4", "-o", "BatchMode=yes",
                        "-o", "ControlMaster=no", HOST, "true"],
                       capture_output=True, text=True)
    return r.returncode == 0


def send_magic_packet(mac=MAC):
    """Broadcast a Wake-on-LAN magic packet. Works on the local LAN (home);
    from off-LAN you'd relay it via homelab. Only wakes from S5, not sleep."""
    import socket
    raw = bytes.fromhex(mac.replace(":", "").replace("-", ""))
    pkt = b"\xff" * 6 + raw * 16
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    for target in ("255.255.255.255", "192.168.1.255"):
        for port in (7, 9):
            try:
                s.sendto(pkt, (target, port))
            except OSError:
                pass
    s.close()


# --- rendering -----------------------------------------------------------
def swatch_bar(swatch, width=4):
    cells = []
    for r, g, b in swatch:
        cells.append(f"\x1b[48;2;{r};{g};{b}m{' ' * width}\x1b[0m")
    return "".join(cells)


def fmt_countdown(secs):
    if secs is None:
        return "held"
    return f"{secs // 60}m{secs % 60:02d}s"


# --- commands ------------------------------------------------------------
def render_lights(st):
    if not st:
        print("no status yet (lights task not running?)")
        return
    if not st.get("on", True):
        if st.get("forced") == "off":
            print(f"🌑 forced off until {st.get('forced_until')}  "
                  "(`auto` to resume schedule)")
        else:
            print("🌙 night — LEDs black  (pick an effect or `on` to light now)")
        return
    eff = st.get("effect", "?")
    line = f"● {eff}"
    if st.get("forced") == "on":
        line += f"  🔦 on until {st.get('forced_until')}"
    elif st.get("rotation"):
        line += f"  ⟳ {st.get('preset')}  next {fmt_countdown(st.get('seconds_left'))}"
    else:
        line += f"  📌 {st.get('mode')}"
    bright = st.get("brightness", 1.0)
    if bright < 1.0:
        line += f"  ☀ {int(bright * 100)}%"
    print(line)
    if st.get("swatch"):
        print(swatch_bar(st["swatch"]))
    if st.get("fans"):
        print("🎯 " + "  ".join(
            f"{n} {swatch_bar([c], 2)}" for n, c in st["fans"].items()))


def cmd_status(args):
    st, age = read_status()
    wedged = engine_wedged(st, age)
    if args.json:
        print(json.dumps(dict(st or {}, engine_age=age, wedged=wedged)))
        return
    if wedged:
        print(wedge_banner(age))
        return
    render_lights(st or {})


def cmd_state(args):
    up = is_reachable()
    lights, age = read_status() if up else (None, None)
    wedged = engine_wedged(lights, age)
    if args.json:
        print(json.dumps({"reachable": up, "lights": lights or {},
                          "engine_age": age, "wedged": wedged}))
        return
    if not up:
        print("🔌 VENGEANCE offline — `lightsctl wake` (or press w) to power on")
        return
    print("✅ VENGEANCE online")
    if wedged:
        print(wedge_banner(age))
        return
    render_lights(lights or {})


def cmd_wake(args):
    send_magic_packet()
    print(f"🔌 magic packet sent to {MAC}")
    if args.wait:
        for i in range(45):
            if is_reachable():
                print(f"✅ VENGEANCE is up (~{i * 2}s)")
                return
            time.sleep(2)
        print("… no answer after 90s — booting from S5 can take a while, "
              "or check BIOS Wake-on-LAN")


def _force(state):
    c = current_control()
    c["force"] = state
    c["force_until"] = next_boundary()
    write_control(c)
    until = time.strftime("%H:%M", time.localtime(c["force_until"]))
    return until


def cmd_on(args):
    print(f"🔦 lights forced on until {_force('on')}  (then back on schedule)")


def cmd_off(args):
    print(f"🌑 lights forced off until {_force('off')}  (then back on schedule)")


def cmd_auto(args):
    c = current_control()
    c.pop("force", None)
    c.pop("force_until", None)
    write_control(c)
    print("🗓  back on schedule (lit 08:00–23:00, black overnight)")


def cmd_list(args):
    if args.json:
        print(json.dumps({"effects": list(effects.EFFECTS),
                          "descriptions": effects.DESCRIPTIONS,
                          "presets": {k: v for k, v in effects.PRESETS.items()}}))
        return
    print("effects:")
    for n in effects.EFFECTS:
        print(f"  {n} — {effects.DESCRIPTIONS.get(n, '')}")
    print("presets:")
    for n, pool in effects.PRESETS.items():
        print(f"  {n}: {', '.join(pool)}")


def cmd_set_effect(args):
    if args.name not in effects.EFFECTS:
        sys.exit(f"unknown effect: {args.name} (see: lightsctl list)")
    c = current_control()
    c.update(mode="pinned", effect=args.name)
    write_control(c)
    print(f"📌 pinned: {args.name}")


def cmd_set_preset(args):
    if args.name not in effects.PRESETS:
        sys.exit(f"unknown preset: {args.name} (see: lightsctl list)")
    c = current_control()
    c.update(mode="rotation", preset=args.name)
    write_control(c)
    print(f"⟳ rotation: {args.name}")


def cmd_rotation(args):
    c = current_control()
    if args.state == "on":
        c["mode"] = "rotation"
        write_control(c)
        print(f"⟳ rotation on ({c.get('preset', 'rotation')})")
    else:
        st = read_remote(STATUS)
        name = st.get("effect")
        if name in effects.EFFECTS:
            c.update(mode="pinned", effect=name)
            print(f"📌 pinned current: {name}")
        else:
            c.update(mode="pinned", effect=next(iter(effects.EFFECTS)))
            print(f"📌 pinned: {c['effect']}")
        write_control(c)


def cmd_reset(args):
    write_control({"mode": "rotation", "preset": "rotation", "brightness": 1.0})
    print("🧼 clean slate: rotation over everything, 100% bright, "
          "no force, no fan overrides")
    st, age = read_status()
    if engine_wedged(st, age):
        print(wedge_banner(age))


def _restart_engine():
    print("🔧 killing engine process on the box…")
    # Engine chain is venv python.exe → base python.exe: uv's pythonw trampoline
    # spawns *console* python, so the ICUELights task hides the whole chain via
    # run-hidden.vbs instead of using pythonw. Kill both console + legacy images.
    _run("taskkill //IM python.exe //F")   # // dodges Git Bash path mangling;
    _run("taskkill //IM pythonw.exe //F")  # pre-vbs task shape, fails ok
    r = _run("MSYS_NO_PATHCONV=1 schtasks /run /tn ICUELights")  # fails ok if
    if r.returncode != 0:                                        # already dead
        sys.exit(f"schtasks /run failed: {(r.stderr or r.stdout).strip()}\n"
                 "(box unreachable? try: lightsctl state)")
    print("🚀 ICUELights relaunched — waiting for a fresh heartbeat…")
    for _ in range(15):
        time.sleep(1)
        st, age = read_status()
        if age is not None and age <= 3:
            print("✅ engine is back:")
            render_lights(st)
            return
    sys.exit("⚠ no fresh status after 15s — on the box, check: "
             "schtasks /query /tn ICUELights /v")


def cmd_restart_engine(args):
    """The other kind of reset: when the engine process itself is hung (stuck
    inside a cuesdk call), nobody reads control.json — kill and relaunch it."""
    _restart_engine()


ROOT = Path(__file__).resolve().parents[3]  # ~/.dotfiles
BOX_CLONE = "dotfiles"                      # home-relative on the box


def _git(*argv):
    return subprocess.run(["git", "-C", str(ROOT), *argv],
                          capture_output=True, text=True)


def cmd_deploy(args):
    """Ship committed lights code: push to origin if needed, ff-pull in the
    box's clone (restoring shared/lights first, in case a dirty `push` left
    working-tree code there), then restart the engine to load it."""
    dirty = _git("status", "--porcelain", "--", "shared/lights").stdout.strip()
    if dirty:
        print("⚠ uncommitted shared/lights changes — these will NOT deploy "
              "(dev loop: lightsctl push):")
        print("\n".join(f"    {l}" for l in dirty.splitlines()))
    unpushed = _git("log", "--oneline", "@{u}..").stdout.strip()
    if unpushed:
        print(f"⬆ pushing {len(unpushed.splitlines())} commit(s) to origin…")
        r = _git("push")
        if r.returncode != 0:
            sys.exit(f"git push failed:\n{r.stderr.strip()}")
    print("⬇ pulling on the box…")
    r = _run(f"cd ~/{BOX_CLONE} && git checkout -- shared/lights && "
             "git pull --ff-only")
    if r.returncode != 0:
        sys.exit(f"pull failed on the box:\n{(r.stderr or r.stdout).strip()}")
    print("  " + (r.stdout.strip().splitlines() or ["?"])[-1])
    _restart_engine()


def cmd_push(args):
    """Dev loop: scp the WORKING TREE's shared/lights/*.py into the box's
    clone and restart the engine — uncommitted effect code on real LEDs in
    seconds. Leaves the box's tree dirty on purpose; when it looks right,
    commit here and `lightsctl deploy` to make it honest."""
    import py_compile
    src = sorted((ROOT / "shared" / "lights").glob("*.py"))
    for p in src:  # don't ship a SyntaxError to the resident engine
        try:
            py_compile.compile(str(p), doraise=True)
        except py_compile.PyCompileError as e:
            sys.exit(f"not pushing — {p.name} doesn't compile:\n{e}")
    scp = ["scp", "-o", "ControlMaster=auto", "-o", f"ControlPath={_SOCK}",
           "-o", "ControlPersist=120", "-o", "BatchMode=yes",
           *[str(p) for p in src], f"{HOST}:{BOX_CLONE}/shared/lights/"]
    r = subprocess.run(scp, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"scp failed:\n{r.stderr.strip()}")
    print(f"📤 pushed working tree: {', '.join(p.name for p in src)}")
    _restart_engine()
    print("⚠ box tree is dirty now — when it looks right: "
          "commit + lightsctl deploy")


FAN_COLOR_NAMES = {
    "red": (255, 0, 0), "orange": (255, 90, 0), "yellow": (255, 220, 0),
    "green": (0, 255, 0), "cyan": (0, 255, 255), "blue": (0, 0, 255),
    "purple": (140, 0, 255), "magenta": (255, 0, 255), "pink": (255, 60, 120),
    "white": (255, 255, 255), "warm": (255, 160, 90), "off": (0, 0, 0),
}


def parse_fan_color(s):
    if s in FAN_COLOR_NAMES:
        return list(FAN_COLOR_NAMES[s])
    hexs = s.lstrip("#")
    if len(hexs) == 6:
        try:
            return [int(hexs[i:i + 2], 16) for i in (0, 2, 4)]
        except ValueError:
            pass
    sys.exit(f"bad color: {s} (name like 'red', or hex like ff8800)")


def cmd_fan(args):
    c = current_control()
    if not args.name:  # bare `lightsctl fan` — show groups and overrides
        fans = c.get("fans") or {}
        for name in list(rig.FANS) + list(rig.ROWS):
            mark = ""
            if name in fans:
                mark = f"  ← {fans[name]} {swatch_bar([fans[name]], 2)}"
            print(f"  {name}{mark}")
        return
    if args.name == "clear":
        c.pop("fans", None)
        write_control(c)
        print("🧹 all fan overrides cleared")
        return
    names = rig.ROWS.get(args.name, [args.name])
    for n in names:
        if n not in rig.FANS:
            sys.exit(f"unknown fan: {args.name} (see: lightsctl fan)")
    if not args.color:
        sys.exit(f"need a color for {args.name} (or 'clear')")
    fans = c.setdefault("fans", {})
    if args.color == "clear":
        for n in names:
            fans.pop(n, None)
        if not fans:
            c.pop("fans", None)
        write_control(c)
        print(f"🧹 cleared: {', '.join(names)}")
        return
    col = parse_fan_color(args.color)
    for n in names:
        fans[n] = col
    write_control(c)
    print(f"🎯 {', '.join(names)} → {swatch_bar([col], 4)}")


def cmd_random(args):
    p = effects.random_params()
    c = current_control()
    c.update(mode="random", params=p)
    write_control(c)
    fn = effects.make_parametric(p)
    print("🎲 rolled a fresh look:")
    print(swatch_bar(effects.sample_swatch(fn, time.time())))


def cmd_brightness(args):
    v = max(0.0, min(1.0, args.value))
    c = current_control()
    c["brightness"] = v
    write_control(c)
    print(f"☀ brightness {int(v * 100)}%")


def cmd_preview(args):
    if args.name not in effects.EFFECTS:
        sys.exit(f"unknown effect: {args.name}")
    fn = effects.EFFECTS[args.name]
    end = time.time() + args.secs
    try:
        while time.time() < end:
            now = time.time()
            sys.stdout.write("\r" + swatch_bar(
                effects.sample_swatch(fn, now, 16), width=2))
            sys.stdout.flush()
            time.sleep(1 / 30)
    except KeyboardInterrupt:
        pass
    sys.stdout.write("\n")


def main():
    ap = argparse.ArgumentParser(prog="lightsctl")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status"); s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("state"); s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_state)
    s = sub.add_parser("wake"); s.add_argument("--wait", action="store_true")
    s.set_defaults(fn=cmd_wake)
    sub.add_parser("on").set_defaults(fn=cmd_on)
    sub.add_parser("off").set_defaults(fn=cmd_off)
    sub.add_parser("auto").set_defaults(fn=cmd_auto)
    s = sub.add_parser("list"); s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("set-effect"); s.add_argument("name")
    s.set_defaults(fn=cmd_set_effect)
    s = sub.add_parser("set-preset"); s.add_argument("name")
    s.set_defaults(fn=cmd_set_preset)
    s = sub.add_parser("rotation"); s.add_argument("state", choices=["on", "off"])
    s.set_defaults(fn=cmd_rotation)
    sub.add_parser("reset").set_defaults(fn=cmd_reset)
    sub.add_parser("restart-engine").set_defaults(fn=cmd_restart_engine)
    sub.add_parser("deploy").set_defaults(fn=cmd_deploy)
    sub.add_parser("push").set_defaults(fn=cmd_push)
    s = sub.add_parser("fan"); s.add_argument("name", nargs="?")
    s.add_argument("color", nargs="?")
    s.set_defaults(fn=cmd_fan)
    s = sub.add_parser("random"); s.set_defaults(fn=cmd_random)
    s = sub.add_parser("brightness"); s.add_argument("value", type=float)
    s.set_defaults(fn=cmd_brightness)
    s = sub.add_parser("preview"); s.add_argument("name")
    s.add_argument("--secs", type=float, default=6.0)
    s.set_defaults(fn=cmd_preview)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
